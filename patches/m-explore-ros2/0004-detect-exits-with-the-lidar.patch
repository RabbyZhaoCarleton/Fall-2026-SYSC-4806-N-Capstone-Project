+int Explore::countUnknown(const geometry_msgs::msg::Point& center, double radius)
+{
+  nav2_costmap_2d::Costmap2D* costmap = costmap_client_.getCostmap();
+  std::lock_guard<nav2_costmap_2d::Costmap2D::mutex_t> lock(*(costmap->getMutex()));
+  const double res = costmap->getResolution();
+  const int r = static_cast<int>(std::ceil(radius / res));
+  int cx, cy;
+  costmap->worldToMapNoBounds(center.x, center.y, cx, cy);
+  const int size_x = static_cast<int>(costmap->getSizeInCellsX());
+  const int size_y = static_cast<int>(costmap->getSizeInCellsY());
+  int count = 0;
+  for (int y = cy - r; y <= cy + r; ++y) {
+    for (int x = cx - r; x <= cx + r; ++x) {
+      if ((x - cx) * (x - cx) + (y - cy) * (y - cy) > r * r) {
+        continue;
+      }
+      // Cells beyond the edge of the map are unknown too: the map grows to
+      // take in whatever the lidar sees there.
+      if (x < 0 || y < 0 || x >= size_x || y >= size_y ||
+          costmap->getCost(x, y) == nav2_costmap_2d::NO_INFORMATION) {
+        ++count;
+      }
+    }
+  }
+  return count;
+}
+
+double Explore::visibleDistance(const Frontier& frontier,
+                                const geometry_msgs::msg::Point& robot)
+{
+  nav2_costmap_2d::Costmap2D* costmap = costmap_client_.getCostmap();
+  std::lock_guard<nav2_costmap_2d::Costmap2D::mutex_t> lock(*(costmap->getMutex()));
+  unsigned int rx, ry;
+  if (!costmap->worldToMap(robot.x, robot.y, rx, ry)) {
+    return std::numeric_limits<double>::infinity();
+  }
+  auto wall = [costmap](int x, int y) {
+    unsigned char cost = costmap->getCost(x, y);
+    return cost >= nav2_costmap_2d::INSCRIBED_INFLATED_OBSTACLE &&
+           cost != nav2_costmap_2d::NO_INFORMATION;
+  };
+  double best = std::numeric_limits<double>::infinity();
+  for (const auto& p : frontier.points) {
+    double d = FrontierMemory::distance(robot, p);
+    unsigned int px, py;
+    if (d >= best || !costmap->worldToMap(p.x, p.y, px, py)) {
+      continue;
+    }
+    // walk the cells between the robot and the frontier cell (Bresenham)
+    int x = rx, y = ry;
+    const int dx = std::abs(static_cast<int>(px) - x);
+    const int dy = -std::abs(static_cast<int>(py) - y);
+    const int sx = x < static_cast<int>(px) ? 1 : -1;
+    const int sy = y < static_cast<int>(py) ? 1 : -1;
+    int err = dx + dy;
+    bool hidden = false;
+    while (!(x == static_cast<int>(px) && y == static_cast<int>(py))) {
+      if (wall(x, y)) {
+        hidden = true;
+        break;
+      }
+      int e2 = 2 * err;
+      if (e2 >= dy) {
+        err += dy;
+        x += sx;
+      }
+      if (e2 <= dx) {
+        err += dx;
+        y += sy;
+      }
+    }
+    if (!hidden) {
+      best = d;
+    }
+  }
+  return best;
+}
+
+bool Explore::watchForExit(const Frontier& current,
+                           const geometry_msgs::msg::Point& robot)
+{
+  const auto& center = watch_.watching() ? watch_.center() : current.centroid;
+  int unknown = countUnknown(center, exit_watch_radius_);
+  if (!watch_.update(this->now().seconds(), visibleDistance(current, robot),
+                     current.centroid, unknown)) {
+    return false;
+  }
+  memory_.set(committed_entry_, State::EXIT, current.centroid);
+  committed_ = false;
+  watch_.reset();
+  RCLCPP_INFO(logger_,
+              "Frontier at (%.2f, %.2f) is a maze exit: the robot has had it "
+              "in view from within %.2f m and the map around it has not grown "
+              "for %.0f s. Heading for another frontier",
+              current.centroid.x, current.centroid.y,
+              visibleDistance(current, robot), exit_watch_time_);
+  return true;
+}
