+
+// A full-circle scan at the origin facing +x: every ray hits a wall at @p range,
+// except those within @p open_deg of @p open_bearing_deg, which return nothing.
+static ScanView scan(double range, double open_bearing_deg = 0.0,
+                     double open_deg = -1.0, double yaw = 0.0)
+{
+  ScanView v;
+  v.yaw = yaw;
+  v.angle_min = 0.0;
+  v.angle_increment = 2.0 * M_PI / 360.0;
+  v.range_min = 0.12;
+  v.range_max = 3.5;
+  for (int i = 0; i < 360; ++i) {
+    double diff = std::fabs(std::remainder(i - open_bearing_deg, 360.0));
+    v.ranges.push_back(open_deg >= 0.0 && diff <= open_deg
+                           ? std::numeric_limits<float>::infinity()
+                           : static_cast<float>(range));
+  }
+  return v;
+}
+
+// Frontier cells across the robot's view at distance @p d, along +x.
+static std::vector<geometry_msgs::msg::Point> across(double d, int n)
+{
+  std::vector<geometry_msgs::msg::Point> points;
+  for (int i = 0; i < n; ++i) {
+    points.push_back(point(d, (i - (n - 1) / 2.0) * 0.05));
+  }
+  return points;
+}
+
+TEST(ExitDetector, frontierWithNoReturnBehindItIsOpen)
+{
+  auto e = explore::scoreFrontier(across(0.5, 9), scan(1.0, 0.0, 30.0));
+  EXPECT_EQ(e.no_return, 9);
+  EXPECT_EQ(explore::judge(e, ExitThresholds()), ExitVerdict::OPEN);
+}
+
+TEST(ExitDetector, frontierWithWallBehindItIsEnclosed)
+{
+  auto e = explore::scoreFrontier(across(0.5, 9), scan(1.0));
+  EXPECT_EQ(e.no_return, 0);
+  EXPECT_EQ(e.returned, 9);
+  EXPECT_EQ(explore::judge(e, ExitThresholds()), ExitVerdict::ENCLOSED);
+}
+
+TEST(ExitDetector, frontierBehindAWallTellsNothing)
+{
+  auto e = explore::scoreFrontier(across(0.5, 9), scan(0.3));
+  EXPECT_EQ(e.no_return + e.returned, 0);
+  EXPECT_EQ(explore::judge(e, ExitThresholds()), ExitVerdict::UNKNOWN);
+}
+
+TEST(ExitDetector, frontierOutOfRangeTellsNothing)
+{
+  auto e = explore::scoreFrontier(across(4.0, 9), scan(1.0, 0.0, 30.0));
+  EXPECT_EQ(e.points, 9);
+  EXPECT_EQ(e.no_return, 0);
+  EXPECT_EQ(explore::judge(e, ExitThresholds()), ExitVerdict::UNKNOWN);
+}
+
+TEST(ExitDetector, usesTheSensorHeading)
+{
+  // facing +y: scan ray 0 points along map +y
+  std::vector<geometry_msgs::msg::Point> ahead;
+  for (int i = 0; i < 9; ++i) {
+    ahead.push_back(point((i - 4) * 0.05, 0.5));
+  }
+  auto e = explore::scoreFrontier(ahead, scan(1.0, 0.0, 30.0, M_PI / 2.0));
+  EXPECT_EQ(e.no_return, 9);
+  // the same frontier straight ahead of a robot facing +x is to its left,
+  // where the walls are
+  auto f = explore::scoreFrontier(ahead, scan(1.0, 0.0, 30.0, 0.0));
+  EXPECT_EQ(f.no_return, 0);
+}
+
+TEST(ExitDetector, partlyOpenFrontierIsNotJudged)
+{
+  // Seen at an angle through an inner opening and out of an exit beyond: only
+  // some of its points look open (a case seen in a recorded run).
+  auto points = across(0.5, 7);
+  auto v = scan(1.0, 0.0, 30.0);
+  // the first three points have a wall behind them
+  for (int i = 0; i < 3; ++i) {
+    points[i].x = 0.5;
+    points[i].y = -0.5 - 0.05 * i;  // about -45 deg, where the walls are
+  }
+  auto e = explore::scoreFrontier(points, v);
+  EXPECT_EQ(e.no_return, 4);
+  EXPECT_EQ(explore::judge(e, ExitThresholds()), ExitVerdict::UNKNOWN);
+}
+
+TEST(ExitDetector, zeroReadingsCanMeanNoReturn)
+{
+  auto v = scan(0.0);
+  EXPECT_EQ(explore::scoreFrontier(across(0.5, 9), v).no_return, 0);
+  v.short_is_no_return = true;
+  EXPECT_EQ(explore::scoreFrontier(across(0.5, 9), v).no_return, 9);
+}
+
+TEST(FrontierMemory, exitIsConfirmedFromASecondPosition)
+{
+  FrontierMemory memory(0.3);
+  auto f = frontier(1.0, 1.4, 0.0);
+  auto seen = memory.observe(f, {f}, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 2);
+  EXPECT_EQ(seen.before, FrontierMemory::State::OPEN);
+  EXPECT_EQ(seen.after, FrontierMemory::State::EXIT_CANDIDATE);
+  // turning on the spot is not a second look
+  memory.observe(f, {f}, ExitVerdict::OPEN, point(0.1, 0.0), 0.3, 2);
+  EXPECT_EQ(memory.state(f), FrontierMemory::State::EXIT_CANDIDATE);
+  seen = memory.observe(f, {f}, ExitVerdict::OPEN, point(0.4, 0.0), 0.3, 2);
+  EXPECT_EQ(seen.after, FrontierMemory::State::EXIT);
+  EXPECT_EQ(memory.entries()[seen.index].exit_views.size(), 2u);
+}
+
+TEST(FrontierMemory, wallsBehindACandidateReopenIt)
+{
+  FrontierMemory memory(0.3);
+  auto f = frontier(1.0, 1.4, 0.0);
+  memory.observe(f, {f}, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 2);
+  auto seen = memory.observe(f, {f}, ExitVerdict::ENCLOSED, point(0.5, 0.5), 0.3, 2);
+  EXPECT_EQ(seen.after, FrontierMemory::State::OPEN);
+  // its earlier look no longer counts towards confirming it
+  memory.observe(f, {f}, ExitVerdict::OPEN, point(0.5, 0.5), 0.3, 2);
+  EXPECT_EQ(memory.state(f), FrontierMemory::State::EXIT_CANDIDATE);
+}
+
+TEST(FrontierMemory, unjudgedFrontiersAreNotRemembered)
+{
+  FrontierMemory memory(0.3);
+  auto a = frontier(1.0, 1.4, 0.0);
+  auto b = frontier(1.0, 1.4, 1.0);
+  memory.observe(a, {a}, ExitVerdict::ENCLOSED, point(0, 0), 0.3, 2);
+  memory.observe(b, {b}, ExitVerdict::UNKNOWN, point(0, 0), 0.3, 2);
+  EXPECT_TRUE(memory.entries().empty());
+}
+
+TEST(FrontierMemory, headingForACandidateKeepsItACandidate)
+{
+  FrontierMemory memory(0.3);
+  auto f = frontier(1.0, 1.4, 0.0);
+  memory.observe(f, {f}, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 2);
+  memory.recordAttempt(f);
+  EXPECT_EQ(memory.state(f), FrontierMemory::State::EXIT_CANDIDATE);
+}
+
+TEST(FrontierMemory, lidarCanTurnGivenUpFrontiersIntoExits)
+{
+  FrontierMemory memory(0.3);
+  auto postponed = frontier(1.0, 1.4, 0.0);
+  auto abandoned = frontier(1.0, 1.4, 1.0);
+  memory.set(memory.recordAttempt(postponed), FrontierMemory::State::POSTPONED,
+             postponed.centroid);
+  memory.set(memory.recordAttempt(abandoned), FrontierMemory::State::ABANDONED,
+             abandoned.centroid);
+  memory.observe(postponed, {postponed}, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 2);
+  memory.observe(abandoned, {abandoned}, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 2);
+  EXPECT_EQ(memory.state(postponed), FrontierMemory::State::EXIT_CANDIDATE);
+  EXPECT_EQ(memory.state(abandoned), FrontierMemory::State::ABANDONED);
+  memory.observe(abandoned, {abandoned}, ExitVerdict::OPEN, point(0.5, 0.0), 0.3, 2);
+  EXPECT_EQ(memory.state(abandoned), FrontierMemory::State::EXIT);
+}
+
+// Seen in simulation: a neighbouring frontier's look was recorded on an exit's
+// entry, and giving up on that neighbour then moved the exit away.
+TEST(FrontierMemory, neighbourCannotTakeOverAnExit)
+{
+  FrontierMemory memory(0.3);
+  std::vector<frontier_exploration::Frontier> both{frontier(1.0, 1.4, 0.0),
+                                                   frontier(1.0, 1.4, 0.25)};
+  const auto& exit = both[0];
+  const auto& neighbour = both[1];
+  memory.observe(exit, both, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 1);
+  ASSERT_EQ(memory.state(exit), FrontierMemory::State::EXIT);
+  // walls behind the neighbour say nothing about the exit
+  auto seen = memory.observe(neighbour, both, ExitVerdict::ENCLOSED, point(0.5, 0.5), 0.3, 1);
+  EXPECT_EQ(seen.index, memory.entries().size());
+  // its own look open to the outside gets its own entry
+  seen = memory.observe(neighbour, both, ExitVerdict::OPEN, point(0.5, 0.5), 0.3, 2);
+  EXPECT_EQ(memory.entries().size(), 2u);
+  EXPECT_EQ(memory.entries()[0].exit_views.size(), 1u);
+  EXPECT_EQ(memory.entries()[0].point.y, exit.centroid.y);
+}
+
+TEST(FrontierMemory, distantFrontierDoesNotAdoptAnEntry)
+{
+  FrontierMemory memory(0.3);
+  auto stale = frontier(1.0, 1.24, -0.88);
+  memory.recordAttempt(stale);
+  // within the match radius of the entry by its cells, not by its centre
+  auto other = frontier(0.75, 0.95, -1.05);
+  ASSERT_TRUE(FrontierMemory::matches(other, memory.entries()[0].point, 0.3));
+  memory.observe(other, {other}, ExitVerdict::OPEN, point(0.0, -1.0), 0.3, 2);
+  EXPECT_EQ(memory.entries().size(), 2u);
+  EXPECT_TRUE(memory.entries()[0].exit_views.empty());
+}
+
+TEST(FrontierMemory, exitsStayPut)
+{
+  FrontierMemory memory(0.3);
+  auto f = frontier(1.0, 1.4, 0.0);
+  auto seen = memory.observe(f, {f}, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 1);
+  memory.set(seen.index, FrontierMemory::State::POSTPONED, point(1.3, -0.4));
+  memory.track(seen.index, point(1.3, -0.4));
+  EXPECT_EQ(memory.state(f), FrontierMemory::State::EXIT);
+  EXPECT_EQ(memory.entries()[seen.index].point.x, f.centroid.x);
+}
+
+TEST(FrontierMemory, bigMoveDropsLidarLooks)
+{
+  FrontierMemory memory(0.3);
+  auto f = frontier(1.0, 1.4, 0.0);
+  auto seen = memory.observe(f, {f}, ExitVerdict::OPEN, point(0.0, 0.0), 0.3, 2);
+  memory.track(seen.index, point(1.25, 0.05));  // drifting with the map: kept
+  EXPECT_EQ(memory.entries()[seen.index].exit_views.size(), 1u);
+  memory.set(seen.index, FrontierMemory::State::POSTPONED, point(1.3, -0.5));
+  EXPECT_TRUE(memory.entries()[seen.index].exit_views.empty());
+}
+
+// ---------------------------------------------------------------- exit watch
+#include <explore/exit_watch.h>
+
+using explore::ExitWatch;
+
+TEST(ExitWatch, quietAreaNearAFrontierIsAnExit)
+{
+  ExitWatch watch(0.4, 6.0, 8);
+  auto c = point(1.0, 0.0);
+  EXPECT_FALSE(watch.update(0.0, 0.3, c, 150));
+  EXPECT_FALSE(watch.update(3.0, 0.3, c, 147));  // a few cells: not growth
+  EXPECT_FALSE(watch.update(5.9, 0.3, c, 147));
+  EXPECT_TRUE(watch.update(6.0, 0.3, c, 146));
+}
+
+TEST(ExitWatch, growingMapRestartsTheTimer)
+{
+  ExitWatch watch(0.4, 6.0, 8);
+  auto c = point(1.0, 0.0);
+  watch.update(0.0, 0.3, c, 150);
+  EXPECT_FALSE(watch.update(4.0, 0.3, c, 120));  // the lidar mapped 30 cells
+  EXPECT_FALSE(watch.update(9.0, 0.3, c, 118));
+  EXPECT_TRUE(watch.update(10.0, 0.3, c, 118));
+}
+
+TEST(ExitWatch, onlyWatchesFromNearby)
+{
+  ExitWatch watch(0.4, 6.0, 8);
+  auto c = point(1.0, 0.0);
+  EXPECT_FALSE(watch.update(0.0, 0.8, c, 150));
+  EXPECT_FALSE(watch.watching());
+  watch.update(1.0, 0.3, c, 150);
+  // backing away restarts the timer once the robot is near again
+  EXPECT_FALSE(watch.update(5.0, 0.6, c, 150));
+  EXPECT_FALSE(watch.update(6.0, 0.3, c, 150));
+  EXPECT_FALSE(watch.update(11.0, 0.3, c, 150));
+  EXPECT_TRUE(watch.update(12.0, 0.3, c, 150));
+}
+
+TEST(ExitWatch, countsAroundWhereTheFrontierWasWhenWatchingBegan)
+{
+  ExitWatch watch(0.4, 6.0, 8);
+  watch.update(0.0, 0.3, point(1.0, 0.0), 150);
+  watch.update(1.0, 0.3, point(1.3, 0.0), 150);
+  EXPECT_DOUBLE_EQ(watch.center().x, 1.0);
+}
