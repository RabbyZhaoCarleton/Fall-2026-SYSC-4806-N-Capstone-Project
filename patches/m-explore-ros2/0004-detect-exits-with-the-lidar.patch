+std::vector<float> Explore::observeExits(const std::vector<Frontier>& frontiers)
+{
+  std::vector<float> ratios(frontiers.size(), -1.0f);
+  if (!exit_detection_) {
+    return ratios;
+  }
+  // The newest scan whose position in the map is known. The map->odom
+  // transform often lags the scan by a few tenths of a second.
+  const std::string map_frame = costmap_client_.getGlobalFrameID();
+  const rclcpp::Time now = this->now();
+  ScanView view;
+  bool placed = false;
+  for (auto it = scans_.rbegin(); it != scans_.rend() && !placed; ++it) {
+    const auto& scan = **it;
+    rclcpp::Time stamp(scan.header.stamp, now.get_clock_type());
+    if (now - stamp > rclcpp::Duration::from_seconds(2.0)) {
+      break;  // older ones are staler still
+    }
+    geometry_msgs::msg::TransformStamped tf;
+    try {
+      tf = tf_buffer_.lookupTransform(map_frame, scan.header.frame_id, stamp);
+    } catch (const tf2::TransformException&) {
+      continue;
+    }
+    const auto& q = tf.transform.rotation;
+    view.x = tf.transform.translation.x;
+    view.y = tf.transform.translation.y;
+    view.yaw = std::atan2(2.0 * (q.w * q.z + q.x * q.y),
+                          1.0 - 2.0 * (q.y * q.y + q.z * q.z));
+    view.angle_min = scan.angle_min;
+    view.angle_increment = scan.angle_increment;
+    view.range_min = scan.range_min;
+    view.range_max = scan.range_max;
+    view.ranges = scan.ranges;
+    view.short_is_no_return = lidar_short_is_no_return_;
+    placed = true;
+  }
+  if (!placed) {
+    return ratios;
+  }
+  geometry_msgs::msg::Point viewpoint;
+  viewpoint.x = view.x;
+  viewpoint.y = view.y;
+
+  for (std::size_t i = 0; i < frontiers.size(); ++i) {
+    const Frontier& f = frontiers[i];
+    ExitEvidence evidence = scoreFrontier(f.points, view);
+    ratios[i] = static_cast<float>(evidence.ratio());
+    ExitVerdict verdict = judge(evidence, exit_thresholds_);
+    if (verdict == ExitVerdict::UNKNOWN) {
+      continue;
+    }
+    // From right next to it, the rays through the frontier fan out widely: if
+    // none of them comes back, one look is enough.
+    bool close = f.min_distance <= exit_confirm_distance_;
+    auto seen = memory_.observe(f, frontiers, verdict, viewpoint,
+                                exit_view_separation_,
+                                close ? 1 : exit_confirm_views_);
+    if (seen.before == seen.after) {
+      continue;
+    }
+    if (seen.after == State::EXIT) {
+      RCLCPP_INFO(logger_,
+                  "Frontier at (%.2f, %.2f) is a maze exit: the lidar saw no "
+                  "return through it from %zu position(s)%s",
+                  f.centroid.x, f.centroid.y,
+                  memory_.entries()[seen.index].exit_views.size(),
+                  close ? ", right next to it" : "");
+    } else if (seen.after == State::EXIT_CANDIDATE) {
+      RCLCPP_INFO(logger_,
+                  "Frontier at (%.2f, %.2f) looks like a maze exit: the lidar "
+                  "sees no return through %d of its %d points. A look from "
+                  "another position, or getting close, decides",
+                  f.centroid.x, f.centroid.y, evidence.no_return, evidence.points);
+    } else if (seen.before == State::EXIT_CANDIDATE) {
+      RCLCPP_INFO(logger_,
+                  "Frontier at (%.2f, %.2f) is not an exit after all: the lidar "
+                  "sees walls behind it",
+                  f.centroid.x, f.centroid.y);
+    }
+  }
+  return ratios;
+}
+
+void Explore::updateFrontiers()
+{
+  auto pose = costmap_client_.getRobotPose();
+  auto frontiers = search_.searchFrom(pose.position);
+  auto no_return_ratios = observeExits(frontiers);
+  bool replan = false;
+  if (committed_ && !settling_ && !exploring_timer_->is_canceled()) {
+    const Frontier* current = findCommitted(frontiers);
+    if (current) {
+      committed_where_ = current->centroid;
+      memory_.track(committed_entry_, committed_where_);
+      replan = leaveForExit(*current) || watchForExit(*current, pose.position);
+    }
+  }
+  if (replan) {
+    makePlan();  // publishes the frontiers too
+  } else {
+    publishFrontiers(frontiers, no_return_ratios);
+  }
+}
+
+static uint8_t stateToMsg(State state)
+{
+  using explore_lite_msgs::msg::Frontier;
+  switch (state) {
+    case State::EXIT_CANDIDATE:
+      return Frontier::EXIT_CANDIDATE;
+    case State::EXIT:
+      return Frontier::EXIT;
+    case State::POSTPONED:
+      return Frontier::POSTPONED;
+    case State::ABANDONED:
+      return Frontier::ABANDONED;
+    default:
+      return Frontier::OPEN;
+  }
+}
+
+void Explore::publishFrontiers(const std::vector<Frontier>& frontiers,
+                               const std::vector<float>& no_return_ratios)
+{
+  if (visualize_) {
+    visualizeFrontiers(frontiers);
+  }
+  explore_lite_msgs::msg::FrontierArray msg;
+  msg.header.frame_id = costmap_client_.getGlobalFrameID();
+  msg.header.stamp = this->now();
+  for (std::size_t i = 0; i < frontiers.size(); ++i) {
+    const Frontier& f = frontiers[i];
+    explore_lite_msgs::msg::Frontier out;
+    out.centroid = f.centroid;
+    out.points = f.points;
+    out.state = stateToMsg(memory_.state(f));
+    out.cost = f.cost;
+    out.path_distance = f.min_distance;
+    out.no_return_ratio = i < no_return_ratios.size() ? no_return_ratios[i] : -1.0f;
+    std::size_t index = memory_.find(f);
+    if (index < memory_.entries().size()) {
+      out.exit_views = memory_.entries()[index].exit_views.size();
+      out.attempts = memory_.entries()[index].attempts;
+    }
+    out.goal = committed_ &&
+               FrontierMemory::matches(f, committed_where_, memory_.matchRadius());
+    msg.frontiers.push_back(out);
+  }
+  frontier_states_pub_->publish(msg);
+  publishExits(frontiers);
+}
+
+void Explore::publishExits(const std::vector<Frontier>& frontiers)
+{
+  // Every exit found so far, also those no longer in the frontier list (when
+  // the map around them changed). Published only when the list changes.
+  explore_lite_msgs::msg::FrontierArray msg;
+  msg.header.frame_id = costmap_client_.getGlobalFrameID();
+  msg.header.stamp = this->now();
+  std::vector<geometry_msgs::msg::Point> points;
+  for (const auto& entry : memory_.entries()) {
+    if (entry.state != State::EXIT) {
+      continue;
+    }
+    explore_lite_msgs::msg::Frontier out;
+    out.centroid = entry.point;
+    out.state = explore_lite_msgs::msg::Frontier::EXIT;
+    out.no_return_ratio = -1.0f;
+    out.exit_views = entry.exit_views.size();
+    out.attempts = entry.attempts;
+    for (const auto& f : frontiers) {
+      if (FrontierMemory::matches(f, entry.point, memory_.matchRadius())) {
+        out.centroid = f.centroid;
+        out.points = f.points;
+        out.cost = f.cost;
+        out.path_distance = f.min_distance;
+        break;
+      }
+    }
+    points.push_back(out.centroid);
+    msg.frontiers.push_back(out);
+  }
+  bool changed = points.size() != published_exits_.size();
+  for (std::size_t i = 0; !changed && i < points.size(); ++i) {
+    changed = FrontierMemory::distance(points[i], published_exits_[i]) > 0.1;
+  }
+  if (!changed) {
+    return;
+  }
+  published_exits_ = points;
+  exits_pub_->publish(msg);
+}
