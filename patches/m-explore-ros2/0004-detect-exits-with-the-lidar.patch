index 0000000..3ca601e
--- /dev/null
+++ b/explore/include/explore/exit_detector.h
@@ -0,0 +1,119 @@
+#ifndef EXIT_DETECTOR_H_
+#define EXIT_DETECTOR_H_
+
+#include <cmath>
+#include <geometry_msgs/msg/point.hpp>
+#include <vector>
+
+namespace explore
+{
+/**
+ * @brief A lidar scan placed in the map frame.
+ *
+ * Gazebo's lidar reports infinity for a ray that hits nothing within range.
+ * slam_toolbox leaves such rays out of the map, so the space outside a maze
+ * exit stays unexplored, and a frontier remains in the opening. Rays that
+ * return nothing through a frontier show that nothing lies behind it within
+ * lidar range: it opens to the outside.
+ */
+struct ScanView {
+  double x{0.0}, y{0.0}, yaw{0.0};  // sensor pose in the map frame
+  double angle_min{0.0};
+  double angle_increment{0.0};
+  double range_min{0.0};
+  double range_max{0.0};
+  std::vector<float> ranges;
+  // The TurtleBot3 LDS driver reports 0 instead of infinity for "no return";
+  // with this set, readings below range_min count as no return too.
+  bool short_is_no_return{false};
+};
+
+/** @brief What one scan shows about the space behind a frontier. */
+struct ExitEvidence {
+  int points{0};     ///< frontier points
+  int no_return{0};  ///< points whose ray came back with nothing within range
+  int returned{0};   ///< points whose ray hit something behind the point
+  double ratio() const
+  {
+    return points > 0 ? static_cast<double>(no_return) / points : 0.0;
+  }
+};
+
+/**
+ * @brief Score frontier points against a scan.
+ *
+ * For each point within lidar range, look at the ray pointing at it. A ray
+ * that hits something before the point is blocked and tells nothing.
+ */
+inline ExitEvidence scoreFrontier(const std::vector<geometry_msgs::msg::Point>& points,
+                                  const ScanView& scan)
+{
+  ExitEvidence e;
+  e.points = static_cast<int>(points.size());
+  const int n = static_cast<int>(scan.ranges.size());
+  if (n == 0 || scan.angle_increment <= 0.0) {
+    return e;
+  }
+  const double two_pi = 2.0 * M_PI;
+  const bool full_circle = n * scan.angle_increment >= two_pi - scan.angle_increment;
+  // A point counts as "behind" a hit only if the hit is at least this much
+  // farther away: frontier cells border the walls they are next to.
+  const double margin = 0.05;
+  for (const auto& p : points) {
+    double dx = p.x - scan.x;
+    double dy = p.y - scan.y;
+    double d = std::hypot(dx, dy);
+    if (d >= scan.range_max) {
+      continue;  // out of lidar range: nothing to learn
+    }
+    double rel = std::fmod(std::atan2(dy, dx) - scan.yaw - scan.angle_min, two_pi);
+    if (rel < 0.0) {
+      rel += two_pi;
+    }
+    int i = static_cast<int>(std::lround(rel / scan.angle_increment));
+    if (i >= n) {
+      if (!full_circle) {
+        continue;  // outside the lidar's field of view
+      }
+      i %= n;
+    }
+    float r = scan.ranges[i];
+    bool no_return = !std::isfinite(r) || r >= scan.range_max ||
+                     (scan.short_is_no_return && r < scan.range_min);
+    if (no_return) {
+      e.no_return++;
+    } else if (r >= scan.range_min && r > d + margin) {
+      e.returned++;
+    }
+  }
+  return e;
+}
+
+/** @brief Thresholds for judging a frontier from one scan. */
+struct ExitThresholds {
+  double ratio{0.75};     ///< share of all frontier points with no return
+  int min_points{5};      ///< fewest no-return points
+  double disprove{0.25};  ///< no-return share of the seen-through points below which it is not an exit
+};
+
+enum class ExitVerdict {
+  UNKNOWN,   ///< not enough of the frontier was visible
+  OPEN,      ///< open to the outside from this viewpoint
+  ENCLOSED,  ///< the lidar saw walls behind it: not an exit
+};
+
+inline ExitVerdict judge(const ExitEvidence& e, const ExitThresholds& t)
+{
+  if (e.no_return >= t.min_points && e.ratio() >= t.ratio) {
+    return ExitVerdict::OPEN;
+  }
+  int seen = e.no_return + e.returned;
+  if (e.returned >= t.min_points &&
+      static_cast<double>(e.no_return) / seen < t.disprove) {
+    return ExitVerdict::ENCLOSED;
+  }
+  return ExitVerdict::UNKNOWN;
+}
+}  // namespace explore
+
+#endif
