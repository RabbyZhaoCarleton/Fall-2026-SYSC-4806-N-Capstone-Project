+# One frontier found by explore_lite: an edge between explored free space and
+# unexplored space, with what explore_lite has concluded about it.
+
+# state values
+uint8 OPEN=0            # may be chosen as a goal
+uint8 EXIT_CANDIDATE=1  # the lidar saw no return through it once: probably a maze exit; still a goal
+uint8 EXIT=2            # a maze exit (seen open from two positions, or the map stayed
+                        # unexplored there while the robot was near); never a goal
+uint8 POSTPONED=3       # given up for now; retried once no open frontier is left
+uint8 ABANDONED=4       # given up too often; never a goal again
+
+geometry_msgs/Point centroid
+geometry_msgs/Point[] points
+uint8 state
+float64 cost              # explore_lite's cost (lower is chosen first)
+float64 path_distance     # m from the robot to the frontier, around walls
+# Share of its points that the latest lidar scan looked through without any
+# return (nothing within range behind them). -1 if no scan could be used.
+float32 no_return_ratio
+uint32 exit_views         # robot positions from which the lidar saw it as open to the outside
+uint32 attempts           # times the robot has set out for it
+bool goal                 # the robot is heading for it now
