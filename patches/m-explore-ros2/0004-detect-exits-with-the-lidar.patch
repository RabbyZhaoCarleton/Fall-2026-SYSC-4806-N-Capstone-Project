+const Frontier* Explore::findCommitted(const std::vector<Frontier>& frontiers) const
+{
+  // The committed frontier moves and changes shape as the map grows, so look
+  // for it where it was last seen.
+  for (const auto& f : frontiers) {
+    if (FrontierMemory::matches(f, committed_where_, memory_.matchRadius())) {
+      return &f;
+    }
+  }
+  return nullptr;
+}
+
+bool Explore::leaveForExit(const Frontier& current)
+{
+  if (memory_.state(current) != State::EXIT) {
+    return false;
+  }
+  committed_ = false;
+  watch_.reset();
+  RCLCPP_INFO(logger_,
+              "Frontier at (%.2f, %.2f) is a maze exit: heading for another "
+              "frontier",
+              committed_where_.x, committed_where_.y);
+  return true;
+}
