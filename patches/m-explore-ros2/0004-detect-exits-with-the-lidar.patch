@@ -0,0 +1,94 @@
+#ifndef EXIT_WATCH_H_
+#define EXIT_WATCH_H_
+
+#include <geometry_msgs/msg/point.hpp>
+
+namespace explore
+{
+/**
+ * @brief Decides that a frontier is a maze exit by watching it from nearby.
+ *
+ * Close to an inner frontier, the lidar maps the space behind it within a
+ * map update or two, so the unknown area around it shrinks. Behind an exit the
+ * lidar gets no return, which the map leaves unknown. If the robot stays near
+ * a frontier and the unknown area around it does not shrink for long enough,
+ * the frontier opens to the outside.
+ */
+class ExitWatch
+{
+public:
+  /**
+   * @param distance  how near (m) the robot must be to a frontier cell it can see
+   * @param time      how long (s) the area must stop shrinking
+   * @param min_growth fewest cells the unknown area must shrink by to count as growth
+   */
+  ExitWatch(double distance = 0.6, double time = 6.0, int min_growth = 8)
+    : distance_(distance), time_(time), min_growth_(min_growth)
+  {
+  }
+
+  void reset()
+  {
+    watching_ = false;
+  }
+
+  bool watching() const
+  {
+    return watching_;
+  }
+
+  /** @brief Where to count unknown cells: the frontier as it was when watching began. */
+  const geometry_msgs::msg::Point& center() const
+  {
+    return center_;
+  }
+
+  /**
+   * @param now        time in seconds
+   * @param distance   robot's distance to the nearest frontier cell it can see (m)
+   * @param centroid   the frontier's centre now; used when watching begins
+   * @param unknown    unknown cells around center() (around @p centroid when
+   *                   not watching yet)
+   * @return true once the frontier counts as an exit
+   */
+  bool update(double now, double distance, const geometry_msgs::msg::Point& centroid,
+              int unknown)
+  {
+    if (distance > distance_) {
+      watching_ = false;  // too far for the lidar to see behind it
+      return false;
+    }
+    if (!watching_) {
+      watching_ = true;
+      center_ = centroid;
+      start_ = now;
+      unknown_ = unknown;
+      return false;
+    }
+    if (unknown_ - unknown >= min_growth_) {
+      // the lidar is still mapping the space behind it: time again from here
+      start_ = now;
+      unknown_ = unknown;
+      return false;
+    }
+    return now - start_ >= time_;
+  }
+
+  /** @brief Seconds the area has gone without shrinking, or 0 when not watching. */
+  double quietFor(double now) const
+  {
+    return watching_ ? now - start_ : 0.0;
+  }
+
+private:
+  double distance_;
+  double time_;
+  int min_growth_;
+  bool watching_{false};
+  geometry_msgs::msg::Point center_;
+  double start_{0.0};
+  int unknown_{0};
+};
+}  // namespace explore
+
+#endif
