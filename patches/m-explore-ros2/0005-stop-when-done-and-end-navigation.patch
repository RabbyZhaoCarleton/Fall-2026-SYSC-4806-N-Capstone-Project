+void Explore::noFrontiersLeft(const char* why,
+                              const std::vector<Frontier>& frontiers)
+{
+  bool checking = finish_check_.pending();
+  if (finish_check_.update(this->now().seconds(), true)) {
+    finishExploring(why, frontiers);
+    return;
+  }
+  if (checking) {
+    return;  // the check is already under way
+  }
+  RCLCPP_INFO(logger_, "%s; checking again in %.0f s before stopping", why,
+              finish_check_.confirmTime());
+  // on the node's clock, so it follows simulation time
+  finish_timer_ = rclcpp::create_timer(
+      this, this->get_clock(),
+      rclcpp::Duration::from_seconds(finish_check_.confirmTime() + 0.1),
+      [this]() {
+        finish_timer_->cancel();
+        if (finish_check_.pending()) {
+          makePlan();
+        }
+      });
+}
