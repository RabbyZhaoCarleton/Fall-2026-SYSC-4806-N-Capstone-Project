@@ -0,0 +1,62 @@
+#ifndef FINISH_CHECK_H_
+#define FINISH_CHECK_H_
+
+namespace explore
+{
+/**
+ * @brief Decides when exploration is over.
+ *
+ * Running out of frontiers to pick can be brief: the search may run just
+ * after a frontier was judged and before the map has caught up with what the
+ * lidar just saw. So exploration is over only once nothing has been left to
+ * pick for @p confirm_time, checked again at the end of that time.
+ */
+class FinishCheck
+{
+public:
+  explicit FinishCheck(double confirm_time = 4.0) : confirm_time_(confirm_time)
+  {
+  }
+
+  /**
+   * @param now current time, s
+   * @param nothing_left true if no frontier is left to pick
+   * @return true once nothing has been left to pick for confirm_time
+   */
+  bool update(double now, bool nothing_left)
+  {
+    if (!nothing_left) {
+      pending_ = false;
+      return false;
+    }
+    if (!pending_) {
+      pending_ = true;
+      since_ = now;
+    }
+    return now - since_ >= confirm_time_;
+  }
+
+  /** @brief True while waiting to see if nothing stays left to pick. */
+  bool pending() const
+  {
+    return pending_;
+  }
+
+  void reset()
+  {
+    pending_ = false;
+  }
+
+  double confirmTime() const
+  {
+    return confirm_time_;
+  }
+
+private:
+  double confirm_time_;
+  bool pending_{false};
+  double since_{0.0};
+};
+}  // namespace explore
+
+#endif
