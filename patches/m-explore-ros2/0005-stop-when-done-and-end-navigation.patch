@@ -425,6 +425,44 @@ TEST(ExitWatch, countsAroundWhereTheFrontierWasWhenWatchingBegan)
   EXPECT_DOUBLE_EQ(watch.center().x, 1.0);
 }
 
+#include <explore/finish_check.h>
+
+using explore::FinishCheck;
+
+TEST(FinishCheck, waitsBeforeStopping)
+{
+  FinishCheck check(4.0);
+  EXPECT_FALSE(check.update(10.0, true));
+  EXPECT_TRUE(check.pending());
+  EXPECT_FALSE(check.update(13.9, true));
+  EXPECT_TRUE(check.update(14.0, true));
+}
+
+TEST(FinishCheck, frontierFoundOnRecheckKeepsExploring)
+{
+  FinishCheck check(4.0);
+  check.update(10.0, true);
+  EXPECT_FALSE(check.update(14.0, false));
+  EXPECT_FALSE(check.pending());
+  // running out again starts a new wait
+  EXPECT_FALSE(check.update(20.0, true));
+  EXPECT_TRUE(check.update(24.0, true));
+}
+
+TEST(FinishCheck, resetStartsOver)
+{
+  FinishCheck check(4.0);
+  check.update(10.0, true);
+  check.reset();
+  EXPECT_FALSE(check.update(14.0, true));
+}
+
+TEST(FinishCheck, zeroConfirmTimeStopsAtOnce)
+{
+  FinishCheck check(0.0);
+  EXPECT_TRUE(check.update(10.0, true));
+}
