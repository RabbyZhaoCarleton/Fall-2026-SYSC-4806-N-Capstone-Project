+void Explore::finishExploring(const char* why,
+                              const std::vector<Frontier>& frontiers)
 {
-  RCLCPP_WARN(logger_, "%s, stopping.", why);
+  finish_check_.reset();
+  // Frontiers the robot gave up on are still unexplored: the map is not
+  // complete, so do not report it as such.
+  std::string abandoned;
+  int count = 0;
+  for (const auto& f : frontiers) {
+    if (memory_.state(f) == State::ABANDONED) {
+      char where[32];
+      std::snprintf(where, sizeof(where), "%s(%.2f, %.2f)", count ? ", " : "",
+                    f.centroid.x, f.centroid.y);
+      abandoned += where;
+      ++count;
+    }
+  }
   auto status_msg = explore_lite_msgs::msg::ExploreStatus();
-  status_msg.status = explore_lite_msgs::msg::ExploreStatus::EXPLORATION_COMPLETE;
+  if (count > 0) {
+    RCLCPP_WARN(logger_,
+                "%s, stopping. Exploration is incomplete: the robot could not "
+                "reach %d frontier(s) at %s",
+                why, count, abandoned.c_str());
+    status_msg.status = explore_lite_msgs::msg::ExploreStatus::EXPLORATION_INCOMPLETE;
+  } else {
+    RCLCPP_WARN(logger_, "%s, stopping.", why);
+    status_msg.status = explore_lite_msgs::msg::ExploreStatus::EXPLORATION_COMPLETE;
+  }
   status_pub_->publish(status_msg);
   stop(true);
+  if (!returning_) {
+    endNavigation("Exploration is over");
+  }
+}
+
+void Explore::endNavigation(const char* why)
+{
+  done_ = true;
+  exploring_timer_->cancel();
+  if (exit_timer_) {
+    exit_timer_->cancel();
+  }
+  if (!exit_when_done_) {
+    RCLCPP_INFO(logger_, "%s: navigation has ended.", why);
+    return;
+  }
+  RCLCPP_INFO(logger_, "%s: navigation has ended, shutting down.", why);
+  // Give the last status message a moment to go out before the node exits.
+  shutdown_timer_ = this->create_wall_timer(std::chrono::seconds(1), [this]() {
+    shutdown_timer_->cancel();
+    rclcpp::shutdown();
+  });
 }
 
