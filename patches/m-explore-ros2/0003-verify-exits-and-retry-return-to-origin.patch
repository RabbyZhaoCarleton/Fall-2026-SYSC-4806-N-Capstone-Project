 void Explore::resume()
 {
+  // exploring again: drop any pending return to the initial pose
+  returning_ = false;
+  if (return_timer_) {
+    return_timer_->cancel();
+  }
   // don't count the paused time against the committed frontier
   commit_start_ = this->now();
   last_progress_ = commit_start_;
