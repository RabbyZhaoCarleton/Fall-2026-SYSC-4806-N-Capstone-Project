+
+void Explore::retryReturn(const char* what)
+{
+  if (!returning_) {
+    return;  // exploration was paused or resumed: the return is no longer wanted
+  }
+  if (return_attempts_ > nav2_retries_) {
+    returning_ = false;
+    RCLCPP_ERROR(logger_,
+                 "The goal to return to the initial pose %s; giving up after "
+                 "%d attempts.",
+                 what, return_attempts_);
+    return;
+  }
+  // Nav2 cancels or fails a goal at once for brief reasons (a cancel meant for
+  // the previous goal, a late transform), so try again shortly.
+  RCLCPP_WARN(logger_,
+              "The goal to return to the initial pose %s; retrying in %.0f s",
+              what, nav2_retry_delay_);
+  return_timer_ = rclcpp::create_timer(
+      this, this->get_clock(), rclcpp::Duration::from_seconds(nav2_retry_delay_),
+      [this]() {
+        return_timer_->cancel();
+        if (returning_) {
+          returnToInitialPose();
+        }
+      });
+}
