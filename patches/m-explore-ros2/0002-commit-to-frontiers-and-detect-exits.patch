+void Explore::commitTo(const frontier_exploration::Frontier& frontier)
+{
+  committed_ = true;
+  settling_ = false;
+  committed_goal_ = frontier.centroid;
+  committed_where_ = frontier.centroid;
+  committed_entry_ = memory_.recordAttempt(frontier);
+  nav2_failures_ = 0;
+  commit_start_ = this->now();
+  last_progress_ = commit_start_;
+  prev_distance_ = frontier.min_distance;
+  RCLCPP_INFO(logger_, "Heading for frontier at (%.2f, %.2f), attempt %d",
+              committed_goal_.x, committed_goal_.y,
+              memory_.attempts(committed_entry_));
+  sendGoal(committed_goal_);
+}
+
+void Explore::giveUp(const std::string& reason,
+                     const geometry_msgs::msg::Point& robot)
+{
+  double distance =
+      std::min(FrontierMemory::distance(robot, committed_goal_),
+               FrontierMemory::distance(robot, committed_where_));
+  if (distance <= exit_reach_distance_) {
+    // Close enough for the lidar to see it: judge it like a reached frontier.
+    RCLCPP_INFO(logger_, "Stopping %.2f m from frontier at (%.2f, %.2f): %s",
+                distance, committed_where_.x, committed_where_.y,
+                reason.c_str());
+    move_base_client_->async_cancel_all_goals();
+    goal_active_ = false;
+    startSettling();
     return;
   }
 
+  committed_ = false;
+  int attempts = memory_.attempts(committed_entry_);
+  if (attempts >= max_frontier_attempts_) {
+    memory_.set(committed_entry_, FrontierMemory::State::ABANDONED,
+                committed_where_);
+    RCLCPP_WARN(logger_, "Abandoning frontier at (%.2f, %.2f) after %d attempts: %s",
+                committed_where_.x, committed_where_.y, attempts,
+                reason.c_str());
+  } else {
+    memory_.set(committed_entry_, FrontierMemory::State::POSTPONED,
+                committed_where_);
+    RCLCPP_INFO(logger_,
+                "Postponing frontier at (%.2f, %.2f): %s. It will be retried "
+                "once the other frontiers are explored",
+                committed_where_.x, committed_where_.y, reason.c_str());
+  }
+}
