diff --git a/explore/include/explore/frontier_memory.h b/explore/include/explore/frontier_memory.h
new file mode 100644
index 0000000..fe146c4
--- /dev/null
+++ b/explore/include/explore/frontier_memory.h
@@ -0,0 +1,161 @@
+#ifndef FRONTIER_MEMORY_H_
+#define FRONTIER_MEMORY_H_
+
+#include <explore/frontier_search.h>
+
+#include <cmath>
+#include <cstddef>
+#include <geometry_msgs/msg/point.hpp>
+#include <vector>
+
+namespace explore
+{
+/**
+ * @brief Remembers frontiers between searches, by location.
+ *
+ * Frontiers are found again from scratch on every search and change shape as
+ * the map grows, so a frontier is recognised by being near a remembered point.
+ * Each remembered frontier has a state and a count of how often the robot has
+ * set out for it.
+ */
+class FrontierMemory
+{
+public:
+  enum class State {
+    OPEN,       ///< may be chosen as a goal
+    POSTPONED,  ///< given up for now; re-opened once no open frontier is left
+    EXIT,       ///< reached but stayed unexplored: a maze exit, never a goal
+    ABANDONED,  ///< given up too often; never a goal again
+  };
+
+  explicit FrontierMemory(double match_radius = 0.3) : match_radius_(match_radius)
+  {
+  }
+
+  /** @brief True if @p frontier lies within @p radius of @p point. */
+  static bool matches(const frontier_exploration::Frontier& frontier,
+                      const geometry_msgs::msg::Point& point, double radius)
+  {
+    if (distance(frontier.centroid, point) <= radius) {
+      return true;
+    }
+    for (const auto& p : frontier.points) {
+      if (distance(p, point) <= radius) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  static double distance(const geometry_msgs::msg::Point& a,
+                         const geometry_msgs::msg::Point& b)
+  {
+    return std::hypot(a.x - b.x, a.y - b.y);
+  }
+
+  /**
+   * @brief State of a frontier. If it matches several remembered frontiers,
+   * the most restrictive state wins (exit, then abandoned, then postponed).
+   */
+  State state(const frontier_exploration::Frontier& frontier) const
+  {
+    State result = State::OPEN;
+    for (const auto& entry : entries_) {
+      if (matches(frontier, entry.point, match_radius_) &&
+          rank(entry.state) > rank(result)) {
+        result = entry.state;
+      }
+    }
+    return result;
+  }
+
+  /**
+   * @brief Count one more attempt at @p frontier.
+   * @return Index of its entry, for the setters below.
+   */
+  std::size_t recordAttempt(const frontier_exploration::Frontier& frontier)
+  {
+    std::size_t index = find(frontier);
+    if (index == entries_.size()) {
+      entries_.push_back(Entry{frontier.centroid, State::OPEN, 0});
+    }
+    entries_[index].state = State::OPEN;
+    entries_[index].attempts++;
+    return index;
+  }
+
+  double matchRadius() const
+  {
+    return match_radius_;
+  }
+
+  int attempts(std::size_t index) const
+  {
+    return entries_.at(index).attempts;
+  }
+
+  /** @brief Set the state and move the remembered point to where the frontier is now. */
+  void set(std::size_t index, State state, const geometry_msgs::msg::Point& point)
+  {
+    entries_.at(index).state = state;
+    entries_.at(index).point = point;
+  }
+
+  /** @brief Re-open every postponed frontier. @return how many were re-opened. */
+  std::size_t reopenPostponed()
+  {
+    std::size_t count = 0;
+    for (auto& entry : entries_) {
+      if (entry.state == State::POSTPONED) {
+        entry.state = State::OPEN;
+        ++count;
+      }
+    }
+    return count;
+  }
+
+private:
+  struct Entry {
+    geometry_msgs::msg::Point point;
+    State state;
+    int attempts;
+  };
+
+  static int rank(State state)
+  {
+    switch (state) {
+      case State::EXIT:
+        return 3;
+      case State::ABANDONED:
+        return 2;
+      case State::POSTPONED:
+        return 1;
+      default:
+        return 0;
+    }
+  }
+
+  /** @brief Index of the entry that matches @p frontier (nearest first), or size() if none. */
+  std::size_t find(const frontier_exploration::Frontier& frontier) const
+  {
+    std::size_t best = entries_.size();
+    double best_distance = 0.0;
+    for (std::size_t i = 0; i < entries_.size(); ++i) {
+      if (!matches(frontier, entries_[i].point, match_radius_)) {
+        continue;
+      }
+      double d = distance(entries_[i].point, frontier.centroid);
+      if (best == entries_.size() || d < best_distance) {
+        best = i;
+        best_distance = d;
+      }
+    }
+    return best;
+  }
+
+  double match_radius_;
+  std::vector<Entry> entries_;
+};
+}  // namespace explore
+
+#endif
