+void Explore::startSettling()
+{
+  settling_ = true;
+  settle_start_ = this->now();
+  // Judge the frontier once the settle time has passed (on the node's clock,
+  // so it follows simulation time).
+  settle_timer_ = rclcpp::create_timer(
+      this, this->get_clock(),
+      rclcpp::Duration::from_seconds(exit_settle_time_ + 0.1), [this]() {
+        settle_timer_->cancel();
+        makePlan();
+      });
+}
