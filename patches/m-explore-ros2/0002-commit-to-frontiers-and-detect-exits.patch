+#include <explore/frontier_memory.h>
+
+using explore::FrontierMemory;
+
+static geometry_msgs::msg::Point point(double x, double y)
+{
+  geometry_msgs::msg::Point p;
+  p.x = x;
+  p.y = y;
+  return p;
+}
+
+// A straight frontier of cells from (x0, y) to (x1, y), 0.05 m apart.
+static frontier_exploration::Frontier frontier(double x0, double x1, double y)
+{
+  frontier_exploration::Frontier f;
+  for (double x = x0; x <= x1 + 1e-9; x += 0.05) {
+    f.points.push_back(point(x, y));
+  }
+  f.centroid = point((x0 + x1) / 2.0, y);
+  f.size = f.points.size();
+  return f;
+}
+
+TEST(FrontierMemory, newFrontierIsOpen)
+{
+  FrontierMemory memory(0.3);
+  EXPECT_EQ(memory.state(frontier(0.0, 0.4, 0.0)), FrontierMemory::State::OPEN);
+}
+
+TEST(FrontierMemory, recognisesFrontierAfterItChangesShape)
+{
+  FrontierMemory memory(0.3);
+  auto index = memory.recordAttempt(frontier(0.0, 0.4, 0.0));
+  memory.set(index, FrontierMemory::State::POSTPONED, point(0.2, 0.0));
+  // shrunk and shifted a little: still the same frontier
+  EXPECT_EQ(memory.state(frontier(0.25, 0.45, 0.05)),
+            FrontierMemory::State::POSTPONED);
+  // a frontier one maze cell away is a different one
+  EXPECT_EQ(memory.state(frontier(0.0, 0.4, 0.5)), FrontierMemory::State::OPEN);
+}
+
+TEST(FrontierMemory, countsAttemptsOnTheSameFrontier)
+{
+  FrontierMemory memory(0.3);
+  auto first = memory.recordAttempt(frontier(0.0, 0.4, 0.0));
+  auto again = memory.recordAttempt(frontier(0.1, 0.4, 0.0));
+  auto other = memory.recordAttempt(frontier(0.0, 0.4, 1.0));
+  EXPECT_EQ(first, again);
+  EXPECT_NE(first, other);
+  EXPECT_EQ(memory.attempts(first), 2);
+  EXPECT_EQ(memory.attempts(other), 1);
+}
+
+TEST(FrontierMemory, reopensOnlyPostponedFrontiers)
+{
+  FrontierMemory memory(0.3);
+  auto postponed = memory.recordAttempt(frontier(0.0, 0.4, 0.0));
+  auto exit = memory.recordAttempt(frontier(0.0, 0.4, 1.0));
+  auto abandoned = memory.recordAttempt(frontier(0.0, 0.4, 2.0));
+  memory.set(postponed, FrontierMemory::State::POSTPONED, point(0.2, 0.0));
+  memory.set(exit, FrontierMemory::State::EXIT, point(0.2, 1.0));
+  memory.set(abandoned, FrontierMemory::State::ABANDONED, point(0.2, 2.0));
+
+  EXPECT_EQ(memory.reopenPostponed(), 1u);
+  EXPECT_EQ(memory.state(frontier(0.0, 0.4, 0.0)), FrontierMemory::State::OPEN);
+  EXPECT_EQ(memory.state(frontier(0.0, 0.4, 1.0)), FrontierMemory::State::EXIT);
+  EXPECT_EQ(memory.state(frontier(0.0, 0.4, 2.0)),
+            FrontierMemory::State::ABANDONED);
+}
+
+TEST(FrontierMemory, exitWinsWhenFrontiersOverlap)
+{
+  FrontierMemory memory(0.3);
+  auto postponed = memory.recordAttempt(frontier(0.0, 0.2, 0.0));
+  auto exit = memory.recordAttempt(frontier(0.6, 0.8, 0.0));
+  memory.set(postponed, FrontierMemory::State::POSTPONED, point(0.1, 0.0));
+  memory.set(exit, FrontierMemory::State::EXIT, point(0.7, 0.0));
+  // one long frontier now covers both
+  EXPECT_EQ(memory.state(frontier(0.0, 0.8, 0.0)), FrontierMemory::State::EXIT);
+}
