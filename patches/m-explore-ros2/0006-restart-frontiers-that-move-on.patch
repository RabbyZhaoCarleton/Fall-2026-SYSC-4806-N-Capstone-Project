+  /**
+   * @brief Start a frontier afresh at @p point: open, with no attempts counted.
+   *
+   * For a frontier that moved on as the robot reached it (the map grew and the
+   * unknown edge is now further along, for example through a doorway). The
+   * attempts so far were at where it used to be, not at where it is now. A maze
+   * exit is left as it is.
+   */
+  void restart(std::size_t index, const geometry_msgs::msg::Point& point)
+  {
+    Entry& entry = entries_.at(index);
+    if (entry.state == State::EXIT) {
+      return;
+    }
+    entry.state = State::OPEN;
+    entry.attempts = 0;
+    track(index, point);
+  }
+
   /** @brief Re-open every postponed frontier. @return how many were re-opened. */
   std::size_t reopenPostponed()
   {
