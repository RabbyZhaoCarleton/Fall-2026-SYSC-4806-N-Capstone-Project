<?xml version="1.0"?>
<package format="3">
  <name>lidar_bringup</name>
  <version>0.1.0</version>
  <description>RPLIDAR C1 bring-up, mock hardware pinout and performance tooling (ROS 2 Jazzy)</description>
  <maintainer email="team@example.com">SYSC 4907 Team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Vendor driver: build from source (see README) -->
  <exec_depend>sllidar_ros2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
