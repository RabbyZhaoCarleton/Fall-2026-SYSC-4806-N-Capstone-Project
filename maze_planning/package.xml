<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maze_planning</name>
  <version>0.1.0</version>
  <description>Global path planning for the maze robot: plans the most time-efficient order to pick up the objects at the entrance and deliver them to their exits. Runs on the Raspberry Pi 5 or a laptop; includes a lightweight simulator and an offline planner.</description>
  <maintainer email="rabbynun@todo.todo">rabbynun</maintainer>
  <license>TODO: License declaration</license>

  <!-- The planner itself -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>maze_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- mock_task_manager and fake_world (simulation stand-ins) -->
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>explore_lite_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
